# ==============================================================================
# Tauhid Shekhar Frontend - Production Environment Variables (.env.example)
# Rename to .env.production or set in your build environment before running 'npm run build'
# ==============================================================================

# Backend API Base URL (must NOT end with a trailing slash)
# If your backend runs on a subdomain (e.g., api.tauhidshekhar.com):
VITE_API_URL=https://api.tauhidshekhar.com/api

# Frontend Client Public URL
VITE_CLIENT_URL=https://tauhidshekhar.com

# Admin Dashboard URL (if hosted together, same as VITE_CLIENT_URL)
VITE_ADMIN_URL=https://tauhidshekhar.com
