{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "(tauhidshekhar.vercel.app|tauhid-shekhar-portfolio-f4xf.vercel.app|tauhidshekhar.app)"
        }
      ],
      "destination": "https://tauhidshekhar-admin.vercel.app/admin",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "(tauhidshekhar.vercel.app|tauhid-shekhar-portfolio-f4xf.vercel.app|tauhidshekhar.app)"
        }
      ],
      "destination": "https://tauhidshekhar-admin.vercel.app/admin/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api|assets|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
