{
  "cleanUrls": true,
  "routes": [
    {
      "src": "/admin",
      "status": 301,
      "headers": { "Location": "https://tauhidshekhar-admin.vercel.app/admin" }
    },
    {
      "src": "/admin/(.*)",
      "status": 301,
      "headers": { "Location": "https://tauhidshekhar-admin.vercel.app/admin/$1" }
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
