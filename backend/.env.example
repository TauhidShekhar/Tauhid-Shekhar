# ==============================================================================
# Tauhid Shekhar Backend - Production Environment Configuration (.env.example)
# Rename this file to .env on your Hostinger / VPS / cloud server and fill in values.
# DO NOT commit real secrets or credentials to public Git repositories!
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=5000

# Client & Admin URLs (CORS & Auth Redirects)
# Replace with your actual live domain names:
CLIENT_URL=https://tauhidshekhar.com
ADMIN_URL=https://tauhidshekhar.com
BACKEND_URL=https://api.tauhidshekhar.com

# MongoDB Database Connection String (MongoDB Atlas or self-hosted)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_db_user:your_secure_password@cluster0.mongodb.net/tauhid_portfolio?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate strong 64-char random hex strings)
# Tip: Generate in terminal via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters_long

# Cloudinary Media Storage (For portfolio images, blog covers, profile pictures)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration (For Contact form, automated notifications, password reset)
# For Hostinger Titan Mail: host=smtp.hostinger.com, port=465 (SSL)
# For Gmail: host=smtp.gmail.com, port=465 (SSL) with App Password
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@tauhidshekhar.com
SMTP_PASS=your_email_account_password

# Google OAuth (Optional - Social Login)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=https://api.tauhidshekhar.com/api/auth/google/callback

# GitHub OAuth (Optional - Social Login)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=https://api.tauhidshekhar.com/api/auth/github/callback

# Google Gemini AI Integration (Optional - AI Assistant / Assistant chat)
GEMINI_API_KEY=your_gemini_api_key

# Cache toggle (Optional: set to 'true' to bypass in-memory caching during debugging)
DISABLE_CACHE=false
